[build-system]
requires = ["uv_build>=0.9.20,<0.10.0"]
build-backend = "uv_build"

[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
dependencies = []

{% if project_kind == "app" -%}
[project.scripts]
{{ project_slug }} = "{{ package_name }}.__main__:main"
{%- endif %}

[dependency-groups]
dev = [
  {%- if use_precommit %}
  "pre-commit",
  {%- endif %}
  "pytest",
  "pyright[nodejs]",
  "ruff",
]
